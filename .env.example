# Git SMS configuration. Copy to .env, keep it private, never commit it.

# --- Required in production ------------------------------------------------------
GIT_SMS_PUBLIC_URL=https://sms.example.org     # base URL Twilio calls; signatures are checked against it
GIT_SMS_SECRET_KEY=                            # 32+ random characters; keys the sender hashes
GIT_SMS_USERS_FILE=/etc/git-sms/users.toml
GIT_SMS_DB_PATH=/var/lib/git-sms/git-sms.db
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- Optional Twilio sending -----------------------------------------------------
# TWILIO_API_KEY_SID=                          # send with a revocable API key instead of the auth token
# TWILIO_API_KEY_SECRET=
# TWILIO_MESSAGING_SERVICE_SID=                # reply via a Messaging Service instead of the receiving number

# --- GitHub: a GitHub App (recommended) or a fine-grained token ---------------------
# GITHUB_APP_ID=
# GITHUB_APP_INSTALLATION_ID=
# GITHUB_APP_PRIVATE_KEY_FILE=/etc/git-sms/github-app.pem
# GITHUB_TOKEN=
# GITHUB_API_URL=https://api.github.com        # GitHub Enterprise Server: https://ghe.example.com/api/v3

# --- Optional AI (summaries and free-form messages) ---------------------------------
# LLM_BASE_URL=https://api.openai.com/v1       # any OpenAI-compatible chat-completions endpoint
# LLM_API_KEY=                                 # (or OPENAI_API_KEY, which implies the OpenAI base URL)
# LLM_MODEL=                                   # required: there is deliberately no default model
# GIT_SMS_NATURAL_LANGUAGE=true

# --- Behaviour and limits (defaults shown) ------------------------------------------
# GIT_SMS_CONFIRM_WRITES=true                  # false is refused in production
# GIT_SMS_CONFIRMATION_TTL_SECONDS=600
# GIT_SMS_MAX_COMMANDS_PER_HOUR=30             # per sender
# GIT_SMS_MAX_WRITES_PER_DAY=20                # per sender
# GIT_SMS_MAX_SEGMENTS_PER_REPLY=3             # longer replies are paged with MORE
# GIT_SMS_MAX_SEGMENTS_PER_DAY=300             # hard ceiling on outbound spend, all senders
# GIT_SMS_MAX_AI_CALLS_PER_DAY=200             # hard ceiling on model calls, all senders (guests never use AI)
# GIT_SMS_RETENTION_DAYS=30                    # processed messages and settled replies
# GIT_SMS_AUDIT_RETENTION_DAYS=365             # audit log and writes whose outcome is still unknown
# GIT_SMS_WORKERS=4                            # worker threads; one sender's messages always run in order
# GIT_SMS_MAX_QUEUED=500                       # beyond this, webhooks get 503 instead of being acknowledged

# --- Server ------------------------------------------------------------------------
# GIT_SMS_HOST=127.0.0.1
# PORT=8000
# LOG_LEVEL=INFO

# --- Development only ----------------------------------------------------------------
# GIT_SMS_ENV=development                      # relaxes production checks
# GIT_SMS_SENDER=console                       # log replies instead of sending
# GIT_SMS_DEV_OUTBOX=outbox.jsonl              # and append their text here
# GIT_SMS_ALLOW_UNSIGNED=true                  # accept unsigned webhooks (only without TWILIO_AUTH_TOKEN)
